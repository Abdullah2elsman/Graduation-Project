<mxfile host="app.diagrams.net" modified="2026-08-31T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="smartbook-v2-erd" name="Smart Book V2 ERD">
    <mxGraphModel dx="2400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;font-size:22px;font-weight:bold;text-align:center;&quot;&gt;Smart Book V2 — Canonical MySQL 8 ERD&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:center;color:#555;&quot;&gt;Locked 2026-08-31 · unified identities · direct course instructor · multiple books · type-driven independent attempts · Laravel → Flask AI drafts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2600" height="70" as="geometry"/></mxCell>

        <mxCell id="users" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#dae8fc;padding:6px;border-bottom:1px solid #6c8ebf;&quot;&gt;users&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;name VARCHAR&lt;br&gt;email VARCHAR UQ — stored normalized lowercase&lt;br&gt;password VARCHAR&lt;br&gt;remember_token VARCHAR?&lt;br&gt;role {ADMIN, INSTRUCTOR, STUDENT} DEFAULT STUDENT&lt;br&gt;status {PENDING, ACTIVE, SUSPENDED, REJECTED} DEFAULT PENDING&lt;br&gt;email_verified_at TIMESTAMP?&lt;br&gt;approved_at TIMESTAMP?&lt;br&gt;approved_by_user_id BIGINT? FK → users.id&lt;br&gt;status_changed_at TIMESTAMP?&lt;br&gt;status_changed_by_user_id BIGINT? FK → users.id&lt;br&gt;status_reason TEXT?&lt;br&gt;created_by_user_id BIGINT? FK → users.id&lt;br&gt;last_login_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;CHK&lt;/b&gt; role, status enums&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (role,status), (status,email_verified_at)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="360" height="470" as="geometry"/></mxCell>

        <mxCell id="sessions" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#dae8fc;padding:6px;border-bottom:1px solid #6c8ebf;&quot;&gt;sessions (framework)&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id VARCHAR PK&lt;br&gt;user_id BIGINT? — index only, no FK (framework-managed)&lt;br&gt;ip_address VARCHAR?&lt;br&gt;user_agent TEXT?&lt;br&gt;payload LONGTEXT&lt;br&gt;last_activity INT&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; user_id, last_activity&lt;br&gt;Stock Laravel database-session table — unchanged&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="360" height="220" as="geometry"/></mxCell>

        <mxCell id="courses" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#d5e8d4;padding:6px;border-bottom:1px solid #82b366;&quot;&gt;courses&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;instructor_id BIGINT? FK → users.id — exactly one when ACTIVE&lt;br&gt;created_by_admin_id BIGINT? FK → users.id&lt;br&gt;instructor_assigned_by_id BIGINT? FK → users.id&lt;br&gt;title VARCHAR&lt;br&gt;description TEXT?&lt;br&gt;status {DRAFT, ACTIVE, ARCHIVED} DEFAULT DRAFT&lt;br&gt;instructor_assigned_at TIMESTAMP?&lt;br&gt;archived_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;CHK&lt;/b&gt; ACTIVE ⇒ instructor_id NOT NULL; instructor_id ⇒ assigned_at&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (instructor_id,status), status&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="360" height="320" as="geometry"/></mxCell>

        <mxCell id="enrollments" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#d5e8d4;padding:6px;border-bottom:1px solid #82b366;&quot;&gt;enrollments&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_id BIGINT FK → courses.id&lt;br&gt;student_id BIGINT FK → users.id&lt;br&gt;status {ACTIVE, CANCELLED} DEFAULT ACTIVE&lt;br&gt;enrolled_by_admin_id BIGINT FK → users.id&lt;br&gt;enrolled_at TIMESTAMP&lt;br&gt;cancelled_by_admin_id BIGINT? FK → users.id&lt;br&gt;cancelled_at TIMESTAMP?&lt;br&gt;cancellation_reason TEXT?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (course_id,student_id) — one canonical lifecycle row&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_id,status), (student_id,status)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="360" height="350" as="geometry"/></mxCell>

        <mxCell id="course_books" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#fff2cc;padding:6px;border-bottom:1px solid #d6b656;&quot;&gt;course_books&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_id BIGINT FK → courses.id&lt;br&gt;uploaded_by_user_id BIGINT FK → users.id&lt;br&gt;title VARCHAR&lt;br&gt;original_name VARCHAR&lt;br&gt;storage_path VARCHAR UQ&lt;br&gt;mime_type VARCHAR&lt;br&gt;file_size BIGINT&lt;br&gt;checksum_sha256 CHAR(64)?&lt;br&gt;page_count INT?&lt;br&gt;status {ACTIVE, ARCHIVED} DEFAULT ACTIVE&lt;br&gt;archived_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_id,status)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="370" height="380" as="geometry"/></mxCell>

        <mxCell id="quizzes" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#e1d5e7;padding:6px;border-bottom:1px solid #9673a6;&quot;&gt;quizzes&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_id BIGINT FK → courses.id&lt;br&gt;created_by_instructor_id BIGINT FK → users.id&lt;br&gt;title VARCHAR&lt;br&gt;instructions TEXT?&lt;br&gt;creation_method {MANUAL, AI} DEFAULT MANUAL&lt;br&gt;status {DRAFT, PUBLISHED, ARCHIVED} DEFAULT DRAFT&lt;br&gt;starts_at TIMESTAMP? — required to PUBLISH&lt;br&gt;ends_at TIMESTAMP? — required to PUBLISH&lt;br&gt;max_attempts INT UNSIGNED DEFAULT 1&lt;br&gt;published_at TIMESTAMP?&lt;br&gt;archived_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;CHK&lt;/b&gt; max_attempts ≥ 1; ends_at &gt; starts_at; PUBLISHED ⇒ both set&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_id,status), (status,starts_at,ends_at)&lt;br&gt;Content immutable once the first attempt starts (app-enforced)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="120" width="390" height="460" as="geometry"/></mxCell>

        <mxCell id="questions" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#e1d5e7;padding:6px;border-bottom:1px solid #9673a6;&quot;&gt;questions — type-driven&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;quiz_id BIGINT FK → quizzes.id&lt;br&gt;type {SINGLE_CHOICE, MULTI_SELECT} DEFAULT SINGLE_CHOICE&lt;br&gt;text TEXT&lt;br&gt;points DECIMAL(8,2) DEFAULT 1&lt;br&gt;position INT UNSIGNED&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (quiz_id,position)&lt;br&gt;&lt;b&gt;CHK&lt;/b&gt; points &gt; 0&lt;br&gt;App: SINGLE_CHOICE ⇒ one correct; MULTI_SELECT ⇒ ≥1 correct&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="620" width="390" height="260" as="geometry"/></mxCell>

        <mxCell id="options" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#e1d5e7;padding:6px;border-bottom:1px solid #9673a6;&quot;&gt;options&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;question_id BIGINT FK → questions.id&lt;br&gt;text TEXT&lt;br&gt;is_correct BOOLEAN DEFAULT FALSE&lt;br&gt;position INT UNSIGNED&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (question_id,position)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="930" width="390" height="200" as="geometry"/></mxCell>

        <mxCell id="quiz_attempts" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f8cecc;padding:6px;border-bottom:1px solid #b85450;&quot;&gt;quiz_attempts&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;quiz_id BIGINT FK → quizzes.id&lt;br&gt;student_id BIGINT FK → users.id&lt;br&gt;attempt_number INT UNSIGNED&lt;br&gt;status {IN_PROGRESS, SUBMITTED} DEFAULT IN_PROGRESS&lt;br&gt;submission_reason {MANUAL, TIME_EXPIRED}? — set when SUBMITTED&lt;br&gt;started_at TIMESTAMP&lt;br&gt;submitted_at TIMESTAMP?&lt;br&gt;score DECIMAL(8,2)?&lt;br&gt;max_score_snapshot DECIMAL(8,2)&lt;br&gt;graded_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (quiz_id,student_id,attempt_number)&lt;br&gt;&lt;b&gt;CHK&lt;/b&gt; symmetric — IN_PROGRESS ⇒ submitted_at/graded_at/score/submission_reason all NULL; SUBMITTED ⇒ all four NOT NULL&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (student_id,quiz_id,status), (quiz_id,status)&lt;br&gt;TIME_EXPIRED scored normally, consumes attempt, valid for best grade&lt;br&gt;Immutability after SUBMITTED is app-enforced (DB CHECK = symmetric lifecycle invariant)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1780" y="120" width="390" height="450" as="geometry"/></mxCell>

        <mxCell id="student_answers" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f8cecc;padding:6px;border-bottom:1px solid #b85450;&quot;&gt;student_answers&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;quiz_attempt_id BIGINT FK → quiz_attempts.id&lt;br&gt;question_id BIGINT FK → questions.id&lt;br&gt;question_text_snapshot TEXT&lt;br&gt;question_type_snapshot {SINGLE_CHOICE, MULTI_SELECT}&lt;br&gt;max_points_snapshot DECIMAL(8,2)&lt;br&gt;points_awarded DECIMAL(8,2) DEFAULT 0&lt;br&gt;is_correct BOOLEAN? — true/false/null(unanswered)&lt;br&gt;answered_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (quiz_attempt_id,question_id)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; question_id&lt;br&gt;Snapshots at attempt start; selected set in student_answer_options&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1780" y="620" width="390" height="400" as="geometry"/></mxCell>

        <mxCell id="student_answer_options" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f8cecc;padding:6px;border-bottom:1px solid #b85450;&quot;&gt;student_answer_options&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;student_answer_id BIGINT FK → student_answers.id&lt;br&gt;option_id BIGINT FK → options.id&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; (student_answer_id,option_id)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; option_id&lt;br&gt;No timestamps — selection time is student_answers.answered_at&lt;br&gt;Normalized selected-option set (SINGLE_CHOICE and MULTI_SELECT)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1780" y="1080" width="390" height="200" as="geometry"/></mxCell>

        <mxCell id="ai_generation_requests" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#ffe6cc;padding:6px;border-bottom:1px solid #d79b00;&quot;&gt;ai_generation_requests&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_book_id BIGINT FK → course_books.id&lt;br&gt;requested_by_instructor_id BIGINT FK → users.id&lt;br&gt;quiz_id BIGINT? FK → quizzes.id (accepted draft, 0..1)&lt;br&gt;start_page INT UNSIGNED&lt;br&gt;end_page INT UNSIGNED&lt;br&gt;question_count INT UNSIGNED&lt;br&gt;difficulty VARCHAR DEFAULT medium (app-validated)&lt;br&gt;provider VARCHAR (Flask adapter)&lt;br&gt;model VARCHAR?&lt;br&gt;status {PENDING, PROCESSING, COMPLETED, FAILED} DEFAULT PENDING&lt;br&gt;draft_payload JSON?&lt;br&gt;error_message TEXT?&lt;br&gt;started_at TIMESTAMP?&lt;br&gt;completed_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;CHK&lt;/b&gt; start_page ≥ 1; end_page ≥ start_page; question_count ≥ 1&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_book_id,status), (requested_by_instructor_id,created_at)&lt;br&gt;Draft questions carry their own type — no request-level question_type&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2220" y="120" width="450" height="480" as="geometry"/></mxCell>

        <mxCell id="rules" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f5f5f5;padding:6px;border-bottom:1px solid #666;&quot;&gt;Locked service rules&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:5px 9px;text-align:left;&quot;&gt;• Email verification is `email_verified_at`, not an account status.&lt;br&gt;• PENDING users cannot access normal application APIs.&lt;br&gt;• One direct instructor per course; a course cannot be ACTIVE without exactly one; role checked by Laravel.&lt;br&gt;• Admin alone mutates enrollments initially.&lt;br&gt;• Attempt lifecycle: IN_PROGRESS → SUBMITTED; submission_reason {MANUAL, TIME_EXPIRED}. TIME_EXPIRED is scored normally, consumes an attempt, and is valid for the best grade.&lt;br&gt;• Best grade = MAX(score) over SUBMITTED attempts — never stored.&lt;br&gt;• Questions are type-driven (SINGLE_CHOICE / MULTI_SELECT); exact-set match grading, no partial credit.&lt;br&gt;• Before quiz ends_at, server hides all scores and answer review.&lt;br&gt;• Result release is fixed to AFTER_END in the MVP (no persisted policy column); MANUAL/custom release is a future extension.&lt;br&gt;• Published history is archived/preserved, never destructively deleted (RESTRICT FKs, no hard deletes).&lt;br&gt;• Submitted-attempt lifecycle is a symmetric DB CHECK (IN_PROGRESS empty / SUBMITTED complete); immutability after SUBMITTED is app-enforced.&lt;br&gt;• Content of a published quiz is immutable once the first attempt starts (app-enforced).&lt;br&gt;• Angular calls Laravel; only Laravel calls Flask.&lt;br&gt;• AI output is a reviewable draft tied to one book/page range; draft questions carry their own type.&lt;br&gt;• book_interactions deferred to Phase 3 (legacy semantics: daily per student/course engagement bucket only).&lt;br&gt;• Framework tables (sessions, cache/cache_locks, jobs/job_batches/failed_jobs, password_reset_tokens, migrations) retained stock.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2220" y="660" width="450" height="430" as="geometry"/></mxCell>

        <mxCell id="e_users_sessions" value="1 : 0..N sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="users" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_courses" value="instructor 1 : N courses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="users" target="courses"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_courses_enrollments" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="courses" target="enrollments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_enrollments" value="student 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="users" target="enrollments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_courses_books" value="1 : N books" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="courses" target="course_books"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_courses_quizzes" value="1 : N quizzes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="courses" target="quizzes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_quizzes_questions" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="quizzes" target="questions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_questions_options" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="questions" target="options"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_quizzes_attempts" value="1 : N attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="quizzes" target="quiz_attempts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_attempts" value="student 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="users" target="quiz_attempts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_attempts_answers" value="1 : N answers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="quiz_attempts" target="student_answers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_questions_answers" value="question snapshot 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="questions" target="student_answers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_answers_selected" value="1 : N selected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="student_answers" target="student_answer_options"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_options_selected" value="selected 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="options" target="student_answer_options"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_books_ai" value="source book 1 : N requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="course_books" target="ai_generation_requests"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_ai" value="requester 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="users" target="ai_generation_requests"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_quizzes_ai" value="accepted draft 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d79b00;fontSize=10;dashed=1;" edge="1" parent="1" source="quizzes" target="ai_generation_requests"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>