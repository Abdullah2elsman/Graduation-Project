  <diagram id="smartbook-v2-erd" name="Smart Book V2 ERD">
    <mxGraphModel dx="2400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;font-size:22px;font-weight:bold;text-align:center;&quot;&gt;Smart Book V2 — Canonical MySQL 8 ERD&lt;/div&gt;&lt;div style=&quot;font-size:12px;text-align:center;color:#555;&quot;&gt;Locked 2026-08-31 · unified identities · direct course instructor · multiple books · independent attempts · Laravel → Flask AI drafts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2600" height="70" as="geometry"/></mxCell>

        <mxCell id="users" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#dae8fc;padding:6px;border-bottom:1px solid #6c8ebf;&quot;&gt;users&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;name VARCHAR&lt;br&gt;email VARCHAR UQ — normalized lowercase&lt;br&gt;password VARCHAR&lt;br&gt;role {ADMIN, INSTRUCTOR, STUDENT}&lt;br&gt;status {PENDING, ACTIVE, SUSPENDED, REJECTED}&lt;br&gt;email_verified_at TIMESTAMP?&lt;br&gt;approved_at TIMESTAMP?&lt;br&gt;approved_by_user_id BIGINT? FK → users.id&lt;br&gt;status_changed_at TIMESTAMP?&lt;br&gt;status_changed_by_user_id BIGINT? FK → users.id&lt;br&gt;status_reason TEXT?&lt;br&gt;created_by_user_id BIGINT? FK → users.id&lt;br&gt;phone VARCHAR?&lt;br&gt;birth_date DATE?&lt;br&gt;avatar_path VARCHAR?&lt;br&gt;last_login_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (role,status), (status,email_verified_at)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="360" height="450" as="geometry"/></mxCell>

        <mxCell id="sessions" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#dae8fc;padding:6px;border-bottom:1px solid #6c8ebf;&quot;&gt;sessions&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id VARCHAR PK&lt;br&gt;user_id BIGINT? FK → users.id SET NULL&lt;br&gt;ip_address VARCHAR?&lt;br&gt;user_agent TEXT?&lt;br&gt;payload LONGTEXT&lt;br&gt;last_activity INT&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; user_id, last_activity&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="360" height="220" as="geometry"/></mxCell>

        <mxCell id="courses" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#d5e8d4;padding:6px;border-bottom:1px solid #82b366;&quot;&gt;courses&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;instructor_id BIGINT FK → users.id NOT NULL&lt;br&gt;created_by_admin_id BIGINT FK → users.id&lt;br&gt;instructor_assigned_by_id BIGINT FK → users.id&lt;br&gt;title VARCHAR&lt;br&gt;description TEXT?&lt;br&gt;status {DRAFT, ACTIVE, ARCHIVED}&lt;br&gt;instructor_assigned_at TIMESTAMP&lt;br&gt;archived_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (instructor_id,status), status&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="360" height="300" as="geometry"/></mxCell>

        <mxCell id="enrollments" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#d5e8d4;padding:6px;border-bottom:1px solid #82b366;&quot;&gt;enrollments&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_id BIGINT FK → courses.id&lt;br&gt;student_id BIGINT FK → users.id&lt;br&gt;status {ACTIVE, CANCELLED}&lt;br&gt;enrolled_by_admin_id BIGINT FK → users.id&lt;br&gt;enrolled_at TIMESTAMP&lt;br&gt;cancelled_by_admin_id BIGINT? FK → users.id&lt;br&gt;cancelled_at TIMESTAMP?&lt;br&gt;cancellation_reason TEXT?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (course_id,student_id)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_id,status), (student_id,status)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="360" height="330" as="geometry"/></mxCell>

        <mxCell id="course_books" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#fff2cc;padding:6px;border-bottom:1px solid #d6b656;&quot;&gt;course_books&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_id BIGINT FK → courses.id&lt;br&gt;uploaded_by_user_id BIGINT FK → users.id&lt;br&gt;title VARCHAR&lt;br&gt;original_name VARCHAR&lt;br&gt;storage_path VARCHAR UQ&lt;br&gt;mime_type VARCHAR&lt;br&gt;file_size BIGINT&lt;br&gt;checksum_sha256 CHAR(64)?&lt;br&gt;page_count INT?&lt;br&gt;status {ACTIVE, ARCHIVED}&lt;br&gt;archived_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_id,status)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="370" height="380" as="geometry"/></mxCell>

        <mxCell id="book_interactions" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#fff2cc;padding:6px;border-bottom:1px solid #d6b656;&quot;&gt;book_interactions&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_book_id BIGINT FK → course_books.id&lt;br&gt;user_id BIGINT FK → users.id&lt;br&gt;event_type {OPEN, PAGE_VIEW, CLOSE}&lt;br&gt;page_number INT?&lt;br&gt;occurred_at TIMESTAMP&lt;br&gt;created_at TIMESTAMP&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_book_id,occurred_at), (user_id,occurred_at)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="370" height="240" as="geometry"/></mxCell>

        <mxCell id="quizzes" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#e1d5e7;padding:6px;border-bottom:1px solid #9673a6;&quot;&gt;quizzes&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_id BIGINT FK → courses.id&lt;br&gt;created_by_instructor_id BIGINT FK → users.id&lt;br&gt;title VARCHAR&lt;br&gt;instructions TEXT?&lt;br&gt;creation_method {MANUAL, AI}&lt;br&gt;status {DRAFT, PUBLISHED, ARCHIVED}&lt;br&gt;starts_at TIMESTAMP? — required to publish&lt;br&gt;ends_at TIMESTAMP? — required to publish&lt;br&gt;max_attempts INT DEFAULT 1&lt;br&gt;result_release_policy {AFTER_END, MANUAL} DEFAULT AFTER_END&lt;br&gt;results_released_at TIMESTAMP?&lt;br&gt;published_at TIMESTAMP?&lt;br&gt;archived_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;CHECK&lt;/b&gt; max_attempts ≥ 1; ends_at after starts_at&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_id,status), (status,starts_at,ends_at)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="120" width="390" height="430" as="geometry"/></mxCell>

        <mxCell id="questions" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#e1d5e7;padding:6px;border-bottom:1px solid #9673a6;&quot;&gt;questions&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;quiz_id BIGINT FK → quizzes.id&lt;br&gt;text TEXT&lt;br&gt;points DECIMAL(8,2)&lt;br&gt;position INT&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (quiz_id,position)&lt;br&gt;&lt;b&gt;CHECK&lt;/b&gt; points &gt; 0&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="620" width="390" height="230" as="geometry"/></mxCell>

        <mxCell id="options" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#e1d5e7;padding:6px;border-bottom:1px solid #9673a6;&quot;&gt;options&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;question_id BIGINT FK → questions.id&lt;br&gt;text TEXT&lt;br&gt;is_correct BOOLEAN&lt;br&gt;position INT&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (question_id,position)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="920" width="390" height="210" as="geometry"/></mxCell>

        <mxCell id="quiz_attempts" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f8cecc;padding:6px;border-bottom:1px solid #b85450;&quot;&gt;quiz_attempts&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;quiz_id BIGINT FK → quizzes.id&lt;br&gt;student_id BIGINT FK → users.id&lt;br&gt;attempt_number INT&lt;br&gt;status {IN_PROGRESS, SUBMITTED, EXPIRED, ABANDONED, INVALIDATED}&lt;br&gt;started_at TIMESTAMP&lt;br&gt;submitted_at TIMESTAMP?&lt;br&gt;score DECIMAL(8,2)?&lt;br&gt;max_score_snapshot DECIMAL(8,2)&lt;br&gt;graded_at TIMESTAMP?&lt;br&gt;invalidated_at TIMESTAMP?&lt;br&gt;invalidation_reason TEXT?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (quiz_id,student_id,attempt_number)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (student_id,quiz_id,status), (quiz_id,status)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1780" y="120" width="390" height="400" as="geometry"/></mxCell>

        <mxCell id="student_answers" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f8cecc;padding:6px;border-bottom:1px solid #b85450;&quot;&gt;student_answers&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;quiz_attempt_id BIGINT FK → quiz_attempts.id&lt;br&gt;question_id BIGINT FK → questions.id&lt;br&gt;selected_option_id BIGINT? FK → options.id&lt;br&gt;question_text_snapshot TEXT&lt;br&gt;selected_option_text_snapshot TEXT?&lt;br&gt;is_correct BOOLEAN?&lt;br&gt;points_awarded DECIMAL(8,2)&lt;br&gt;max_points_snapshot DECIMAL(8,2)&lt;br&gt;answered_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; (quiz_attempt_id,question_id)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; question_id, selected_option_id&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1780" y="600" width="390" height="360" as="geometry"/></mxCell>

        <mxCell id="ai_generation_requests" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#ffe6cc;padding:6px;border-bottom:1px solid #d79b00;&quot;&gt;ai_generation_requests&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:3px 7px;text-align:left;&quot;&gt;id BIGINT PK&lt;br&gt;course_book_id BIGINT FK → course_books.id&lt;br&gt;requested_by_instructor_id BIGINT FK → users.id&lt;br&gt;quiz_id BIGINT? FK → quizzes.id&lt;br&gt;start_page INT&lt;br&gt;end_page INT&lt;br&gt;question_count INT&lt;br&gt;difficulty VARCHAR&lt;br&gt;question_type VARCHAR DEFAULT MCQ&lt;br&gt;provider VARCHAR&lt;br&gt;model VARCHAR?&lt;br&gt;status {PENDING, PROCESSING, COMPLETED, FAILED}&lt;br&gt;draft_payload JSON?&lt;br&gt;error_message TEXT?&lt;br&gt;started_at TIMESTAMP?&lt;br&gt;completed_at TIMESTAMP?&lt;br&gt;created_at / updated_at&lt;br&gt;&lt;b&gt;CHECK&lt;/b&gt; start_page ≥ 1; end_page ≥ start_page&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; (course_book_id,status), (requested_by_instructor_id,created_at)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2220" y="120" width="420" height="470" as="geometry"/></mxCell>

        <mxCell id="rules" value="&lt;div style=&quot;font-size:15px;font-weight:bold;text-align:center;background:#f5f5f5;padding:6px;border-bottom:1px solid #666;&quot;&gt;Locked service rules&lt;/div&gt;&lt;div style=&quot;font-size:11px;padding:5px 9px;text-align:left;&quot;&gt;• Email verification is `email_verified_at`, not an account status.&lt;br&gt;• PENDING users cannot access normal application APIs.&lt;br&gt;• One direct instructor per course; role validity enforced by Laravel.&lt;br&gt;• Admin alone mutates enrollments initially.&lt;br&gt;• Best grade = MAX(score) over valid SUBMITTED attempts.&lt;br&gt;• Before quiz `ends_at`, server hides all scores and answer review.&lt;br&gt;• `AFTER_END` is the initial release policy; fields permit a later policy.&lt;br&gt;• Published academic history is archived/preserved, not destructively deleted.&lt;br&gt;• Angular calls Laravel; only Laravel calls Flask.&lt;br&gt;• AI output is a reviewable draft tied to one book/page range.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;strokeWidth=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2220" y="680" width="420" height="330" as="geometry"/></mxCell>

        <mxCell id="e_users_sessions" value="1 : 0..N sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="users" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_courses" value="instructor 1 : N courses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="users" target="courses"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_courses_enrollments" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="courses" target="enrollments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_enrollments" value="student 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="users" target="enrollments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_courses_books" value="1 : N books" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="courses" target="course_books"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_books_interactions" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="course_books" target="book_interactions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_interactions" value="reader 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="users" target="book_interactions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_courses_quizzes" value="1 : N quizzes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="courses" target="quizzes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_quizzes_questions" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="quizzes" target="questions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_questions_options" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="questions" target="options"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_quizzes_attempts" value="1 : N attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="quizzes" target="quiz_attempts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_attempts" value="student 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="users" target="quiz_attempts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_attempts_answers" value="1 : N answers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="quiz_attempts" target="student_answers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_questions_answers" value="question snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="questions" target="student_answers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_options_answers" value="selected 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="options" target="student_answers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_books_ai" value="source book 1 : N requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="course_books" target="ai_generation_requests"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_users_ai" value="requester 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="users" target="ai_generation_requests"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_quizzes_ai" value="accepted draft 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#d79b00;fontSize=10;dashed=1;" edge="1" parent="1" source="quizzes" target="ai_generation_requests"><mxGeometry relative="1" as="geometry"/></mxCell>
