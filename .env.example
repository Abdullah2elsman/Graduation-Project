# Smart Book V2 — Docker Compose environment template (development only).
#
# Onboarding:
#   cp .env.example .env
#   docker compose up --build
#
# Every value below is a development placeholder, not a real secret.
# The V2 runtime is fully containerised; no host PHP/Node/Python/MySQL needed.

# Compose project name (prefixes all generated resources).
COMPOSE_PROJECT_NAME=smart-book-v2

# Locked V2 host-port allocation.
# Legacy keeps 5501 (static frontend) and 8005 (Laravel) and is unaffected.
BACKEND_PORT=8080
FRONTEND_PORT=4200
AI_PORT=5001
MYSQL_PORT=3307
MAILPIT_UI_PORT=8025

# V2-only MySQL database (never shared with Legacy, whose DB is named "project").
MYSQL_DATABASE=smart_book_v2
MYSQL_USER=smartbook
MYSQL_PASSWORD=smartbook_dev_password
MYSQL_ROOT_PASSWORD=smartbook_root_dev_password

# Public URL of the Laravel API when running in Docker.
BACKEND_APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200

# First-party SPA session/CSRF settings. Browser URLs consistently use
# localhost; Sanctum host entries include their ports.
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
SESSION_COOKIE=smart_book_v2_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Optional external-DNS override for backend/frontend containers (used during
# the startup dependency install). Defaults to 1.1.1.1. Environment-specific
# accommodation for hosts whose Docker embedded DNS cannot reach external
# resolvers; internal Compose service-name resolution is unaffected.
# Set DOCKER_DNS to a public resolver reachable from your network if needed.
DOCKER_DNS=1.1.1.1
